; Engine configuration file.
; Shadow Assassin — original top-down 2D stealth game (Godot 4.3).

config_version=5

[application]

config/name="Shadow Assassin"
config/description="Original top-down 2D stealth assassin game. Sneak, hide, strike — clear all 10 levels."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
; v6 BMS boot splash (Buddhika, 2026-11-21): the first thing the player
; sees at launch is BMS — big bold letters on a dark background — never
; the Godot logo. Shown at full size, at least 1.5s, on a dark purple
; background that blends with the image edges on taller screens.
boot_splash/bg_color=Color(0.05, 0.03, 0.1, 1)
boot_splash/image="res://art/bms_splash.png"
boot_splash/fullsize=true
boot_splash/minimum_display_time=1500

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[autoload]

AdMob="*res://scripts/admob.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/bin_decode/plugin.cfg")
